{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commcrae-super-bowl-picks",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "build": {"command": "node scripts/build-cloudflare.cjs"},
  "assets": {"directory": "./cloudflare/public", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none"},
  "durable_objects": {"bindings": [{"name": "PICKS_STORE", "class_name": "PicksStore"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PicksStore"]}],
  "vars": {"PUBLIC_ORIGIN": "https://picks.commcrae.com"}
}
